{
  "schemaVersion": 1,
  "id": "mineqtt",
  "version": "${version}",
  "name": "MineQTT",
  "description": "Interact with the Internet of Things through Minecraft.",
  "authors": [
    "OddHero"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "LGPL-3.0",
  "icon": "assets/mineqtt/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "art.rehra.mineqtt.fabric.MineqttFabric"
    ],
    "client": [
      "art.rehra.mineqtt.fabric.client.MineqttFabricClient"
    ],
    "modmenu": [
      "art.rehra.mineqtt.fabric.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "mineqtt.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
