{
  "name": "node-red-contrib-mineqtt",
  "version": "0.1.1",
  "description": "Node-RED nodes for MineQTT: every Minecraft smart device (lamps, switches, sensors, locks, alarm panels) and its Home Assistant counterpart as a node to wire flows with",
  "keywords": [
    "node-red",
    "minecraft",
    "mineqtt",
    "mqtt",
    "home-assistant",
    "smart-home",
    "digital-twin"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/OddHero/Mineqtt.git",
    "directory": "integrations/node-red"
  },
  "homepage": "https://github.com/OddHero/Mineqtt/wiki",
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "mineqtt-config": "nodes/config.js",
      "mineqtt-devices": "nodes/devices.js"
    }
  },
  "files": [
    "lib/",
    "nodes/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-html.js",
    "test": "node scripts/build-html.js --check && node --test test/"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "node-red": "^5.0.9",
    "node-red-node-test-helper": "^0.3.6"
  }
}
