    {
      "t": "mineqtt/world_7f3a/porch_interval_timer/availability"
    }
  ],
  "avty_mode": "all",
  "qos": 1,
  "cmps": {
    "enabled": {
      "p": "switch",
      "unique_id": "mineqtt_7173e000000040008000000000000001_enabled",
      "name": null,
      "state_topic": "mineqtt/world_7f3a/porch_interval_timer",
      "command_topic": "mineqtt/world_7f3a/porch_interval_timer/set",
      "value_template": "{{ 'OFF' if value_json.enabled == false else 'ON' }}",
      "payload_on": "{\"state\":\"ON\"}",
      "payload_off": "{\"state\":\"OFF\"}",
      "state_on": "ON",
      "state_off": "OFF",
      "retain": false
    },
    "fired": {
      "p": "event",
      "unique_id": "mineqtt_7173e000000040008000000000000001_fired",
      "name": "Fired",
      "state_topic": "mineqtt/world_7f3a/porch_interval_timer/action",
      "event_types": [
        "fired"
      ]
    },
    "trigger": {
      "p": "button",
      "unique_id": "mineqtt_7173e000000040008000000000000001_trigger",
      "name": "Trigger now",
      "command_topic": "mineqtt/world_7f3a/porch_interval_timer/set/trigger",
      "payload_press": "PRESS",
      "retain": false
    },
    "next_fire": {
      "p": "sensor",
      "unique_id": "mineqtt_7173e000000040008000000000000001_next_fire",
      "name": "Next fire",
      "state_topic": "mineqtt/world_7f3a/porch_interval_timer",
      "value_template": "{{ value_json.next_fire if value_json.next_fire else None }}",
      "device_class": "timestamp"
    },
    "interval": {
      "p": "number",
      "unique_id": "mineqtt_7173e000000040008000000000000001_interval",
      "name": "Interval",
      "state_topic": "mineqtt/world_7f3a/porch_interval_timer",
      "value_template": "{{ value_json.interval }}",
      "command_topic": "mineqtt/world_7f3a/porch_interval_timer/set/interval",
      "min": 1,
      "max": 1000000,
      "step": 1,
      "retain": false,
      "entity_category": "config"
    },
    "unit": {
      "p": "select",
      "unique_id": "mineqtt_7173e000000040008000000000000001_unit",
      "name": "Unit",
      "state_topic": "mineqtt/world_7f3a/porch_interval_timer",
      "value_template": "{{ value_json.unit }}",
      "command_topic": "mineqtt/world_7f3a/porch_interval_timer/set/unit",
      "options": [
        "ticks",
        "seconds",
        "minutes",
        "hours"
      ],
      "retain": false,
      "entity_category": "config"
    },
    "location": {
      "p": "sensor",
      "unique_id": "mineqtt_7173e000000040008000000000000001_location",
      "name": "Location",
      "state_topic": "mineqtt/world_7f3a/porch_interval_timer",
      "value_template": "{{ value_json.location.dimension }} {{ value_json.location.pos | join(',') }}",
      "entity_category": "diagnostic",
      "enabled_by_default": false
    }
  }
