    },
    "signal": {
      "p": "sensor",
      "unique_id": "mineqtt_0c4d8e2f6a1b4c3d9e5f708192a3b4c5_signal",
      "name": "Signal",
      "state_topic": "mineqtt/world_7f3a/doorbell",
      "value_template": "{{ value_json.signal }}",
      "state_class": "measurement"
    },
    "pulse": {
      "p": "event",
      "unique_id": "mineqtt_0c4d8e2f6a1b4c3d9e5f708192a3b4c5_pulse",
      "name": "Pulse",
      "state_topic": "mineqtt/world_7f3a/doorbell/action",
      "event_types": ["pulse"]
    },
    "location": {
      "p": "sensor",
      "unique_id": "mineqtt_0c4d8e2f6a1b4c3d9e5f708192a3b4c5_location",
      "name": "Location",
      "state_topic": "mineqtt/world_7f3a/doorbell",
      "value_template": "{{ value_json.location.dimension }} {{ value_json.location.pos | join(',') }}",
