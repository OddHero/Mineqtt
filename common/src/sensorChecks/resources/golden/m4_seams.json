      "value_template": "{{ value_json.time }}",
      "command_topic": "mineqtt/world_7f3a/seams/set/time",
      "max": 255,
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "retain": false,
      "entity_category": "config"
    },
    "next_fire": {
      "p": "sensor",
      "unique_id": "mineqtt_3f9c2d1e8a7b4c6d9e0f112233445566_next_fire",
