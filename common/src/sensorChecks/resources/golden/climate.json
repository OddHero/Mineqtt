    },
    "location": {
      "p": "sensor",
      "unique_id": "mineqtt_c1a7e0004d2b4f3a9e8d7c6b5a493821_location",
      "name": "Location",
      "state_topic": "mineqtt/world_7f3a/greenhouse_climate",
      "value_template": "{{ value_json.location.dimension }} {{ value_json.location.pos | join(',') }}",
      "entity_category": "diagnostic",
      "enabled_by_default": false
    }
