      "device_class": "temperature",
      "state_class": "measurement"
    },
    "humidity": {
      "p": "sensor",
      "unique_id": "mineqtt_c1a7e0004d2b4f3a9e8d7c6b5a493821_humidity",
      "name": "Humidity",
      "state_topic": "mineqtt/world_7f3a/greenhouse_climate",
      "value_template": "{{ value_json.humidity }}",
      "unit_of_measurement": "%",
      "device_class": "humidity",
      "state_class": "measurement"
    },
    "illuminance": {
      "p": "sensor",
      "unique_id": "mineqtt_c1a7e0004d2b4f3a9e8d7c6b5a493821_illuminance",
      "name": "Illuminance",
      "state_topic": "mineqtt/world_7f3a/greenhouse_climate",
      "value_template": "{{ value_json.illuminance }}",
      "unit_of_measurement": "lx",
      "device_class": "illuminance",
      "state_class": "measurement"
    },
    "interval": {
      "p": "number",
      "unique_id": "mineqtt_c1a7e0004d2b4f3a9e8d7c6b5a493821_interval",
      "name": "Interval",
      "state_topic": "mineqtt/world_7f3a/greenhouse_climate",
      "value_template": "{{ value_json.interval }}",
