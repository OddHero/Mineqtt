      "retain": false,
      "entity_category": "config"
    },
    "biome": {
      "p": "sensor",
      "unique_id": "mineqtt_c1a7e0004d2b4f3a9e8d7c6b5a493821_biome",
      "name": "Biome",
      "state_topic": "mineqtt/world_7f3a/greenhouse_climate",
      "value_template": "{{ value_json.biome }}",
