{
  "dev": {
    "ids": ["mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812"],
    "name": "Hallway Sensor",
    "mf": "MineQTT",
    "mdl": "Presence Sensor",
    "mdl_id": "mineqtt:presence_sensor",
    "sw": "2.0.0",
    "via_device": "mineqtt_bridge_5b0e9a7c3d2f41e8a6c4b1d09f8e7a63"
  },
  "o": { "name": "MineQTT", "sw": "2.0.0", "url": "https://github.com/OddHero/Mineqtt" },
  "avty": [
    { "t": "mineqtt/world_7f3a/bridge/state" },
    { "t": "mineqtt/world_7f3a/hallway_sensor/availability" }
  ],
  "avty_mode": "all",
  "qos": 1,
  "cmps": {
    "occupancy": {
      "p": "binary_sensor",
      "unique_id": "mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812_occupancy",
      "name": "Occupancy",
      "state_topic": "mineqtt/world_7f3a/hallway_sensor",
      "value_template": "{{ 'ON' if value_json.occupancy else 'OFF' }}",
      "device_class": "occupancy"
    },
    "count": {
      "p": "sensor",
      "unique_id": "mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812_count",
      "name": "Count",
      "state_topic": "mineqtt/world_7f3a/hallway_sensor",
      "value_template": "{{ value_json.count }}",
      "state_class": "measurement"
    },
    "detect": {
      "p": "select",
      "unique_id": "mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812_detect",
      "name": "Detect",
      "state_topic": "mineqtt/world_7f3a/hallway_sensor",
      "value_template": "{{ value_json.detect }}",
      "command_topic": "mineqtt/world_7f3a/hallway_sensor/set/detect",
      "options": ["players", "mobs", "all"],
      "retain": false,
      "entity_category": "config"
    },
    "range": {
      "p": "number",
      "unique_id": "mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812_range",
      "name": "Range",
      "state_topic": "mineqtt/world_7f3a/hallway_sensor",
      "value_template": "{{ value_json.range }}",
      "command_topic": "mineqtt/world_7f3a/hallway_sensor/set/range",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit_of_measurement": "blocks",
      "retain": false,
      "entity_category": "config"
    },
    "clear_delay": {
      "p": "number",
      "unique_id": "mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812_clear_delay",
      "name": "Clear delay",
      "state_topic": "mineqtt/world_7f3a/hallway_sensor",
      "value_template": "{{ value_json.clear_delay }}",
      "command_topic": "mineqtt/world_7f3a/hallway_sensor/set/clear_delay",
      "min": 0,
      "max": 3600,
      "step": 1,
      "unit_of_measurement": "s",
      "retain": false,
      "entity_category": "config"
    },
    "location": {
      "p": "sensor",
      "unique_id": "mineqtt_5e6f7a8b9c0d4e1fa2b3c4d5e6f70812_location",
      "name": "Location",
      "state_topic": "mineqtt/world_7f3a/hallway_sensor",
      "value_template": "{{ value_json.location.dimension }} {{ value_json.location.pos | join(',') }}",
      "entity_category": "diagnostic",
      "enabled_by_default": false
    }
  }
}
